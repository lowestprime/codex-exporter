include Export-CodexThread.py
include Install-CodexThreadExporter.ps1
include README.md CHANGELOG.md COMPATIBILITY.md CONTRIBUTING.md SECURITY.md LICENSE
recursive-include bash *.sh
recursive-include docs *.md
recursive-include powershell *.ps1
recursive-include skills *
recursive-include tests *.py *.jsonl *.md
recursive-include tools *.py
prune .github
prune .pytest_cache
prune build
prune dist
# Never package interpreter-generated bytecode, even if it appears beneath
# recursively included self-contained skill directories during validation.
global-exclude *.py[cod]
global-exclude __pycache__
